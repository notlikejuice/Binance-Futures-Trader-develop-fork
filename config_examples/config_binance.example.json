{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "exchange": {
        "name": "binance",
        "key": "api_token",
        "secret": "secret_token",
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "defaultType": "future"
            }
        },
        "pair_whitelist": [
            ".*USDT"
        ],
        "pair_blacklist": []
    },
    "trading_mode": "futures",
    "margin_mode": "cross",
    "proxy_coin": "BNFCR",
    "stake_currency": "BNB",
    "stake_amount": 0.05,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "max_open_trades": 5,
    "minimal_roi": {
        "0": 0.1,
        "30": 0.05,
        "60": 0.02
    },
    "stoploss": -0.07,
    "stoploss_on_exchange": false, 
    "trailing_stop": true,
    "trailing_stop_positive": 0.03,
    "trailing_stop_positive_offset": 0.05,
    "trailing_only_offset_is_reached": true,
    "timeframe": "5m",
    "telegram": {
        "enabled": true,
        "token": "telegram_token",
        "chat_id": "id_chat",
        "keyboard": [
            [
                "/daily",
                "/stats",
                "/balance",
                "/profit"
            ],
            [
                "/status table",
                "/performance"
            ],
            [
                "/reload_config",
                "/count",
                "/logs"
            ]
        ]
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "jwt_secret",
        "ws_token": "ws_token",
        "CORS_origins": [
            "http://0.0.0.0:8080/"
        ],
        "username": "freqtrader",
        "password": "admin"
    },
    "bot_name": "binance_bot",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "entry_pricing": {
            "price_side": "same",
            "use_order_book": true,
            "order_book_top": 1,
            "check_depth_of_market": {
                "enabled": true,
                "bids_to_ask_delta": 1
            }
        },
        "exit_pricing": {
            "price_side": "same",
            "use_order_book": true,
            "order_book_top": 1,
            "process_throttle_secs": 5
        }
    },
    "protection": {
        "max_drawdown": {
            "enabled": true,
            "lookback_period_candles": 48,
            "trade_limit": 10,
            "stop_duration_candles": 12,
            "max_allowed_drawdown": 0.25
        },
        "stoploss_guard": {
            "enabled": true,
            "lookback_period_candles": 24,
            "trade_limit": 5,
            "stop_duration_candles": 6
        },
        "low_profit_pairs": {
            "enabled": true,
            "lookback_period_candles": 12,
            "trade_limit": 3,
            "required_profit": 0.015,
            "stop_duration_candles": 8
        }
    }
}
